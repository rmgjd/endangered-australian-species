{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Average decline in relative abundance in the TSX sample, 1985 to 2022",
  "width": "container",
  "height": 230,
  "background": null,
  "padding": 8,
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "gridColor": "#dce7de",
      "domainColor": "#8fa59b",
      "tickColor": "#8fa59b",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "labelFontSize": 12,
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/tsx_groups.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 5,
        "color": "#d6e1d6"
      },
      "encoding": {
        "x": {
          "field": "decline_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Average relative abundance decline since 1985 (%)"
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Amphibians",
            "Reptiles",
            "Birds",
            "Mammals"
          ],
          "title": null
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 185,
        "color": "#a53935"
      },
      "encoding": {
        "x": {
          "field": "decline_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Average relative abundance decline since 1985 (%)"
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Amphibians",
            "Reptiles",
            "Birds",
            "Mammals"
          ],
          "title": null
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "decline_pct",
            "type": "quantitative",
            "title": "Decline %"
          },
          {
            "field": "taxa",
            "type": "quantitative",
            "title": "Monitored taxa"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.decline_pct, '.0f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#a53935"
      },
      "encoding": {
        "x": {
          "field": "decline_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Average relative abundance decline since 1985 (%)"
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Amphibians",
            "Reptiles",
            "Birds",
            "Mammals"
          ],
          "title": null
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "decline_pct",
            "type": "quantitative",
            "title": "Decline %"
          },
          {
            "field": "taxa",
            "type": "quantitative",
            "title": "Monitored taxa"
          }
        ],
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "group": "Amphibians",
            "decline_pct": 97
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#a53935",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "decline_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Amphibians",
            "Reptiles",
            "Birds",
            "Mammals"
          ]
        },
        "x2": {
          "value": {
            "expr": "width * .91"
          }
        },
        "y2": {
          "value": -19
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "lineHeight": 14,
        "color": "#a53935"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width * 0.98"
          }
        },
        "y": {
          "value": -35
        },
        "text": {
          "value": "Amphibian and reptile samples\nshow 94–97% average declines"
        }
      }
    }
  ]
}
