{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Average decline in relative abundance in the TSX sample, 1985 to 2022",
  "width": "container",
  "height": 230,
  "background": null,
  "padding": 8,
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "gridColor": "#dce7de",
      "domainColor": "#8fa59b",
      "tickColor": "#8fa59b",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "labelFontSize": 11
    }
  },
  "data": {
    "url": "data/tsx_groups.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 5,
        "color": "#d6e1d6"
      },
      "encoding": {
        "x": {
          "field": "decline_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Average relative abundance decline since 1985 (%)"
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Amphibians",
            "Reptiles",
            "Birds",
            "Mammals"
          ],
          "title": null
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 185,
        "color": "#a53935"
      },
      "encoding": {
        "x": {
          "field": "decline_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Average relative abundance decline since 1985 (%)"
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Amphibians",
            "Reptiles",
            "Birds",
            "Mammals"
          ],
          "title": null
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "decline_pct",
            "type": "quantitative",
            "title": "Decline %"
          },
          {
            "field": "taxa",
            "type": "quantitative",
            "title": "Monitored taxa"
          }
        ]
      }
    }
  ]
}
