{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of currently listed threatened fauna entries by animal group",
  "width": "container",
  "height": 255,
  "background": null,
  "padding": 8,
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "gridColor": "#dce7de",
      "domainColor": "#8fa59b",
      "tickColor": "#8fa59b",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "labelFontSize": 12,
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/group_totals.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#2b7566",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "count",
          "type": "quantitative",
          "title": "EPBC listed entries",
          "scale": {
            "domain": [
              0,
              190
            ]
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Birds",
            "Mammals",
            "Invertebrates",
            "Reptiles",
            "Fish",
            "Amphibians"
          ],
          "title": null
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Entries"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#18302b"
      },
      "encoding": {
        "x": {
          "field": "count",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              190
            ]
          },
          "title": "EPBC listed entries"
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Birds",
            "Mammals",
            "Invertebrates",
            "Reptiles",
            "Fish",
            "Amphibians"
          ],
          "title": null
        },
        "text": {
          "field": "count"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "group": "Birds",
            "count": 164
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {
          "field": "count",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              190
            ]
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Birds",
            "Mammals",
            "Invertebrates",
            "Reptiles",
            "Fish",
            "Amphibians"
          ]
        },
        "text": {
          "value": "26.2% of the list"
        }
      }
    }
  ]
}
