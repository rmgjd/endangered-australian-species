{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "EPBC conservation status by animal group",
  "width": "container",
  "height": 250,
  "background": null,
  "padding": 8,
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "gridColor": "#dce7de",
      "domainColor": "#8fa59b",
      "tickColor": "#8fa59b",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "labelFontSize": 12,
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/status_matrix.json"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "status",
          "type": "nominal",
          "sort": [
            "Critically Endangered",
            "Endangered",
            "Vulnerable"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelExpr": "datum.label === 'Critically Endangered' ? 'Critical' : datum.label"
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Birds",
            "Mammals",
            "Reptiles",
            "Amphibians",
            "Fish",
            "Invertebrates"
          ],
          "title": null
        },
        "color": {
          "field": "count",
          "type": "quantitative",
          "scale": {
            "scheme": "orangered"
          },
          "title": "Entries"
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Entries"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "status",
          "type": "nominal",
          "sort": [
            "Critically Endangered",
            "Endangered",
            "Vulnerable"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelExpr": "datum.label === 'Critically Endangered' ? 'Critical' : datum.label"
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Birds",
            "Mammals",
            "Reptiles",
            "Amphibians",
            "Fish",
            "Invertebrates"
          ],
          "title": null
        },
        "text": {
          "field": "count"
        },
        "color": {
          "condition": {
            "test": "datum.count >= 50",
            "value": "#fff"
          },
          "value": "#18302b"
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Entries"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.group === 'Invertebrates' && datum.status === 'Critically Endangered'"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#a53935",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "status",
          "type": "nominal",
          "sort": [
            "Critically Endangered",
            "Endangered",
            "Vulnerable"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelExpr": "datum.label === 'Critically Endangered' ? 'Critical' : datum.label"
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Birds",
            "Mammals",
            "Reptiles",
            "Amphibians",
            "Fish",
            "Invertebrates"
          ],
          "title": null
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Entries"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": "normal",
        "lineBreak": "\n",
        "lineHeight": 14,
        "color": "#18302b"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width * 0"
          }
        },
        "y": {
          "value": -17
        },
        "text": {
          "value": "Critical listings peak among invertebrates"
        }
      }
    }
  ]
}
