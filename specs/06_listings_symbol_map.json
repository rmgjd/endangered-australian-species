{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "EPBC threatened fauna entries flagged as occurring in each state",
  "width": "container",
  "height": 340,
  "background": null,
  "padding": 8,
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "gridColor": "#dce7de",
      "domainColor": "#8fa59b",
      "tickColor": "#8fa59b",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "labelFontSize": 12,
      "orient": "bottom"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dfe9df",
        "stroke": "#fff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/state_centres.json"
      },
      "mark": {
        "type": "circle",
        "color": "#2b7566",
        "opacity": 0.78,
        "stroke": "#fff",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "count",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "range": [
              0,
              1250
            ]
          },
          "legend": {
            "orient": "bottom",
            "values": [
              50,
              150,
              250
            ],
            "direction": "horizontal"
          },
          "title": "Listed entries"
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Listed entries"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_centres.json"
      },
      "mark": {
        "type": "text",
        "dy": -25,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#18302b"
      },
      "transform": [
        {
          "filter": "datum.state !== 'ACT' && datum.state !== 'VIC'"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    }
  ]
}
