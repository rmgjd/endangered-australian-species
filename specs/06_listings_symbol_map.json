{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bivariate proportional-symbol map: total state occurrence counts and critically endangered share of listed entries",
  "width": "container",
  "height": 340,
  "background": null,
  "padding": 8,
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "gridColor": "#dce7de",
      "domainColor": "#8fa59b",
      "tickColor": "#8fa59b",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#18302b",
      "titleColor": "#18302b",
      "labelFontSize": 12,
      "orient": "bottom",
      "layout": {
        "bottom": {
          "direction": "horizontal",
          "anchor": "start",
          "margin": 44
        }
      }
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dfe9df",
        "stroke": "#fff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/state_centres.json"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.92,
        "stroke": "#fff",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "count",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "range": [
              0,
              1250
            ]
          },
          "legend": {
            "orient": "bottom",
            "values": [
              50,
              150,
              250
            ],
            "direction": "horizontal",
            "titlePadding": 9,
            "symbolFillColor": "#557069",
            "symbolStrokeColor": "#557069"
          },
          "title": "Listed entries"
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Listed entries"
          },
          {
            "field": "critical",
            "type": "quantitative",
            "title": "Critically endangered entries"
          },
          {
            "field": "critical_pct",
            "type": "quantitative",
            "title": "Critically endangered share (%)"
          }
        ],
        "color": {
          "field": "critical_pct",
          "type": "quantitative",
          "scale": {
            "scheme": "orangered",
            "domain": [
              0,
              25
            ]
          },
          "title": "Critical share (%)",
          "legend": {
            "orient": "bottom",
            "gradientLength": 150,
            "direction": "horizontal",
            "titlePadding": 9
          }
        }
      }
    },
    {
      "data": {
        "url": "data/state_centres.json"
      },
      "mark": {
        "type": "text",
        "dy": -25,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#18302b"
      },
      "transform": [
        {
          "filter": "datum.state !== 'ACT' && datum.state !== 'VIC'"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "point": {
              "type": "Point",
              "coordinates": [
                144.533,
                -22.573
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#18302b",
        "opacity": 0.65
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "geoCentroid('projection', datum.point)[0]"
          }
        },
        "y": {
          "value": {
            "expr": "geoCentroid('projection', datum.point)[1]"
          }
        },
        "x2": {
          "value": {
            "expr": "width * 0.82"
          }
        },
        "y2": {
          "value": {
            "expr": "height * 0.18 + 22"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": "normal",
        "lineBreak": "\n",
        "lineHeight": 14,
        "color": "#18302b"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width * 0.98"
          }
        },
        "y": {
          "value": {
            "expr": "height * 0.18"
          }
        },
        "text": {
          "value": "QLD: 21.6% critical\nHighest state share"
        }
      }
    }
  ]
}
